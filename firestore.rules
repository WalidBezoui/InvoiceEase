rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ────────────────────────────────────────────

    // Check if the request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the document being written has the correct userId
    function hasCorrectUserId() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Check if userId is not being changed on update
    function userIdUnchanged() {
      return resource.data.userId == request.resource.data.userId;
    }

    // ─── Users Collection ────────────────────────────────────────────
    // Users can only read/write their own profile

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasCorrectUserId();
      allow update: if isOwner(userId) && userIdUnchanged();
      allow delete: if false; // Users cannot delete their profile via client
    }

    // ─── User Preferences ────────────────────────────────────────────
    // Document ID is the user's UID

    match /userPreferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // ─── Invoices ────────────────────────────────────────────────────
    // Users can CRUD their own invoices

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid;
    }

    // ─── Clients ─────────────────────────────────────────────────────
    // Users can CRUD their own clients

    match /clients/{clientId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid;
    }

    // ─── Products ────────────────────────────────────────────────────
    // Users can CRUD their own products

    match /products/{productId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      
      allow delete: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid;
    }

    // ─── Product Transactions ────────────────────────────────────────
    // Users can read their own transactions
    // Create is allowed (for stock operations)
    // Update/Delete are NOT allowed (append-only audit trail)

    match /productTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      
      // Transactions are append-only — no updates or deletes
      allow update, delete: if false;
    }

    // ─── Default: Deny All ───────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
